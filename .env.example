# 복사해서 service/.env 로 만든다. .env는 Git에 올리지 않는다.
MYSQL_HOST=192.168.0.232
MYSQL_PORT=3306
MYSQL_DATABASE=dart_big_in
MYSQL_USER=dart_backend
MYSQL_PASSWORD=
# Linux/WSL 기본값은 faiss이므로 명시한다.
SEARCH_BACKEND=numpy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# KRX OpenAPI '지수 일별시세' 승인 키
KRX_API=
OPENDART_API_KEY=
